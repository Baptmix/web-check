---
import Icon from '@components/molecules/Icon.svelte';

const themes = [
  { value: 'dark', label: 'Dark', icon: 'moon' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'system', label: 'System', icon: 'desktop' },
];

const defaultTheme = 'dark';
const name = `theme-${crypto.randomUUID()}`;
---

<div class="theme-switcher" role="radiogroup" aria-label="Theme">
  {themes.map(({ value, label, icon }) => (
    <label title={label}>
      <input
        type="radio"
        name={name}
        value={value}
        aria-label={label}
        checked={value === defaultTheme}
      />
      <Icon name={icon} />
    </label>
  ))}
</div>
<script is:inline>
  window.webCheckTheme?.apply();
</script>

<style lang="scss">
  .theme-switcher {
    --size: 2rem;
    --pad: 0.25rem;
    position: relative;
    display: inline-flex;
    flex: none;
    padding: var(--pad);
    border: 1px solid color-mix(in srgb, var(--text-color) 10%, transparent);
    border-radius: 2rem;
    background: var(--background-raised);

    // Thumb that glides under whichever option is checked
    &::before {
      content: '';
      position: absolute;
      inset-block: var(--pad);
      left: var(--pad);
      width: var(--size);
      border-radius: inherit;
      background: color-mix(in srgb, var(--primary) 16%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 35%, transparent);
      translate: calc(var(--index, 0) * 100%);
      transition: translate 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    &:has(label:nth-child(2) :checked) {
      --index: 1;
    }
    &:has(label:nth-child(3) :checked) {
      --index: 2;
    }

    // Bigger targets for touch
    @media (pointer: coarse) {
      --size: 2.5rem;
    }
  }

  label {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--text-color-secondary);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;

    :global(svg) {
      transition: scale 0.2s ease;
    }

    &:hover {
      color: var(--text-color);
      background: color-mix(in srgb, var(--text-color) 6%, transparent);
    }
    &:active :global(svg) {
      scale: 0.85;
    }
    &:has(:checked) {
      color: var(--primary);
      background: none;
    }
  }

  // The real radio stays focusable and clickable, it just has no look of its own
  input {
    position: absolute;
    inset: 0;
    margin: 0;
    border-radius: inherit;
    appearance: none;
    cursor: inherit;

    &:focus {
      outline: none;
    }
    &:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switcher::before,
    label,
    label :global(svg) {
      transition: none;
    }
  }
</style>
